{
  "name": "jobtracker-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "gen:api": "uv --directory ../backend run python -m app.dump_openapi > src/api/openapi.json && openapi-typescript src/api/openapi.json -o src/api/schema.gen.ts --default-non-nullable false && prettier --write src/api/openapi.json src/api/schema.gen.ts",
    "lint": "oxlint && tsc -b --noEmit && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "preview": "vite preview",
    "e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.61.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "recharts": "3.10.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.5"
}
